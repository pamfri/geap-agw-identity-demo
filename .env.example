# GCP Projects & Region
export REGION="us-central1"
export PROJECT_A_ID="your-project-a-id"
export PROJECT_B_ID="your-project-b-id"

# GitHub OAuth App Credentials (required when creating 'github-mcp-auth' in Auth Manager for the first time)
# Redirect URI in GitHub OAuth App settings must be:
# https://agentidentitycredentials.googleapis.com/v1/projects/${PROJECT_A_ID}/locations/${REGION}/authProviders/github-mcp-auth/oauthcallback
export GITHUB_OAUTH_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
export GITHUB_OAUTH_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
