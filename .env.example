# ==============================================================================
# SecOps Agent Gateway + SPIFFE + IAP v2 + SGP Environment Configuration
# Copy this file to `.env` (gitignored) and fill in your GCP & OAuth values.
# ==============================================================================

# GCP Region & Projects (Project A = Governance Hub, Project B = Isolated MCP Spoke)
REGION=us-central1
PROJECT_A_ID=your-project-a-id
PROJECT_B_ID=your-project-b-id

# Optional: Numeric Project Numbers & Org ID (auto-detected via gcloud if omitted)
# PROJECT_A_NUM=123456789012
# PROJECT_B_NUM=234567890123
# ORG_ID=987654321098

# Optional: Existing Reasoning Engine IDs (populated automatically by deploy_agents.py into agents/spiffe_identities.env)
# RE_1_ID=
# RE_2_ID=

# GitHub OAuth App credentials for 3-Legged OAuth (3LO) in Google Cloud Managed Auth Manager
# Configure GitHub OAuth App callback URL as:
#   https://agentidentitycredentials.googleapis.com/v1/projects/${PROJECT_A_ID}/locations/${REGION}/authProviders/github-mcp-auth/oauthcallback
GITHUB_OAUTH_CLIENT_ID=PASTE_YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=PASTE_YOUR_GITHUB_OAUTH_CLIENT_SECRET

# Demo GitHub repository used in Semantic Governance Policy smoke test & HITL examples
DEMO_GITHUB_REPO=your-github-org/your-demo-repo
# Optional comma-separated allowlist of GitHub orgs/owners for Agent 1's local guardrail mirror
# ALLOWED_GITHUB_ORGS=your-github-org,secops-enterprise

# Optional: Cross-Cloud Azure Functions MCP Server URL (for `scripts/setup_azure_mcp_and_key.sh`)
AZURE_MCP_URL=https://your-azure-mcp-app.azurewebsites.net/runtime/webhooks/mcp

# Optional: Gemini Enterprise App ID & Display Name (for `scripts/publish_to_gemini_enterprise.sh`)
GE_APP_ID=secops-governance-hub
GE_APP_DISPLAY_NAME="SecOps Governance Hub"
