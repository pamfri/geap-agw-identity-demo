# Local environment variables & OAuth secrets
.env
.env.*
!.env.example
*.env
!terraform/terraform.tfvars.example

# Generated SPIFFE workload identities & runtime outputs
agents/spiffe_identities.env
spiffe_identities.env

# GCP Service Account keys & credentials (NEVER commit)
*key*.json
*credentials*.json
azure-mcp-trace-writer-key.json
*.pem
*.p12

# Python bytecode, virtualenvs & caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Terraform state, caches & local variable files
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/.terraform.lock.hcl

# Archives & OS metadata
*.tar.gz
*.tgz
*.zip
.DS_Store
.vscode/
.idea/

# Out-of-scope / excluded scripts
scripts/extend_alt4_control_plane_observability.sh
