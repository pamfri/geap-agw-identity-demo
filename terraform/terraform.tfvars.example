org_id                     = "YOUR_NUMERIC_ORG_ID"
billing_account            = "012345-6789AB-CDEF01"
access_policy_id           = "YOUR_NUMERIC_ACM_POLICY_ID"
project_a_id               = "your-project-a-id"
project_b_id               = "your-project-b-id"
region                     = "us-central1"
github_oauth_client_id     = "PASTE_YOUR_GITHUB_CLIENT_ID"
github_oauth_client_secret = "PASTE_YOUR_GITHUB_CLIENT_SECRET"
mcp_container_image        = "us-central1-docker.pkg.dev/your-project-b-id/mcp-repo/internal-mcp-server:latest"
# Optional override; defaults to https://secops-3lo-callback-<PROJECT_A_NUM>.<REGION>.run.app/validateUserId
# oauth_default_continue_uri = "https://secops-3lo-callback-123456789012.us-central1.run.app/validateUserId"
